OPENAI_API_KEY=your-openai-api-key

# Backend Configuration
BACKEND_PORT=3001
JWT_SECRET=your-jwt-secret-change-in-production
NODE_ENV=development

# Security Configuration
# Encryption secret for document encryption at rest (required in production)
ENCRYPTION_SECRET=your-encryption-secret-change-in-production

# SSL/TLS Configuration (optional - use when not behind a TLS-terminating proxy)
# SSL_KEY_PATH=/path/to/ssl/private.key
# SSL_CERT_PATH=/path/to/ssl/certificate.crt

# AI Service Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Frontend Configuration
VITE_API_URL=http://localhost:3001
VITE_AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_PATH=./data/database.sqlite
